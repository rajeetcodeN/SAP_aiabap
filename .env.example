# -------------------------------------------------------------
# SAP On-Premise DEV Connection Configuration
# -------------------------------------------------------------
SAP_URL=http://sapdev.company.corp:8000
SAP_CLIENT=100
SAP_USER=DEVELOPER
SAP_PASSWORD=
SAP_LANGUAGE=EN
SAP_ALLOW_SELF_SIGNED=true

# Set to true to force offline simulation mode even if URL is configured
SAP_OFFLINE_MODE=true

# -------------------------------------------------------------
# AI Provider Keys (Optional: Leave empty for built-in synthesizer)
# -------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# -------------------------------------------------------------
# Web App Settings
# -------------------------------------------------------------
PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
